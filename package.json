{
  "name": "lysozyme-gdmcl-lab",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "prepare:structure": "node scripts/fetch-structure.mjs",
    "validate:structure": "node scripts/validate-structure.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run prepare:structure && npm run validate:structure",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:model": "node --experimental-strip-types --test scripts/*.test.mjs",
    "predev": "npm run prepare:structure && npm run validate:structure"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/node": "^22.10.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
